# MongoDB Atlas connection string
# Get it from: Atlas → Cluster → Connect → Drivers → copy the string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/daymate?retryWrites=true&w=majority

# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Express server port
PORT=3001
